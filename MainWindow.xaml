<Window x:Class="Folderize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Folderize"
        xmlns:converters="clr-namespace:Folderize.Converters"
        xmlns:models="clr-namespace:Folderize.Models"
        xmlns:views="clr-namespace:Folderize.Views"
        mc:Ignorable="d"
        Title="Folderize"
        Icon="/app.ico"
        Height="820" Width="1280"
        MinHeight="680" MinWidth="1020"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" MaxWidth="70.0" />
        <converters:PercentToWidthConverter x:Key="Top5BarWidthConverter" MaxWidth="80.0" />
        <converters:PercentToWidthConverter x:Key="AppPercentBarConverter" MaxWidth="90.0" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BooleanToVisibilityInvertedConverter x:Key="InvertedBoolToVisibility" />
        <converters:LanguageActiveBgConverter x:Key="LanguageActiveBgConverter" />
        <converters:LanguageActiveFgConverter x:Key="LanguageActiveFgConverter" />

        <!-- Primary Toolbar Button Style ("Tara" / Scan button with dark disabled state) -->
        <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#151F32" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#334155" />
                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Outline Toolbar Button Style (Select Folder) -->
        <Style x:Key="ToolbarDefaultButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#151F32" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Stop Toolbar Button Style (Durdur) -->
        <Style x:Key="ToolbarDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon / Refresh Toolbar Button Style -->
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#151F32" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#475569" />
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="8,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Sidebar Item Style -->
        <Style x:Key="SidebarNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Drive Card Button Style -->
        <Style x:Key="DriveCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#151F32" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Margin="8,4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#1E293B" />
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander Toggle Button Style (Fixes closure bug with OneWay binding) -->
        <Style x:Key="NodeExpanderButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="ArrowPath"
                                  Data="M 5 3 L 10 8 L 5 13 Z"
                                  Fill="#94A3B8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowPath" Property="Data" Value="M 3 5 L 8 10 L 13 5 Z" />
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="50" />
            <!-- Main Content (Sidebar + Dashboard) -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Logo / Title -->
                    <ColumnDefinition Width="220" />
                    <!-- Search / Action Buttons -->
                    <ColumnDefinition Width="*" />
                    <!-- Drive Badge & Settings -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Logo & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/icon_32.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Folderize" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" FontFamily="Segoe UI" />
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v0.3" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Middle: Scan Toolbar Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <!-- Select Folder -->
                    <Button Command="{Binding SelectFolderCommand}"
                            Style="{StaticResource ToolbarDefaultButtonStyle}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="#FBBF24" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
                            <TextBlock Text="{Binding Strings.SelectFolder}" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <!-- Start Scan -->
                    <Button Command="{Binding StartScanCommand}"
                            Style="{StaticResource ToolbarPrimaryButtonStyle}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
                            <TextBlock Text="{Binding Strings.StartScan}" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <!-- Stop Button (if scanning) -->
                    <Button Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource ToolbarDangerButtonStyle}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M6,6H18V18H6V6Z" />
                            <TextBlock Text="{Binding Strings.StopScan}" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource ToolbarIconButtonStyle}"
                            ToolTip="{Binding Strings.RescanToolTip}">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"
                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" />
                    </Button>
                </StackPanel>

                <!-- Right: Drive Storage Indicator, Language Switcher & Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Active Drive Pill -->
                    <Border Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M6,2H18A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12,4A6,6 0 0,0 6,10C6,12.19 7.18,14.11 8.93,15.16L8,19H16L15.07,15.16C16.82,14.11 18,12.19 18,10A6,6 0 0,0 12,4Z" />
                            <TextBlock Text="{Binding SelectedPath}" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FormattedTotalSize}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Language Switcher Pills (TR / EN) -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="TR" Command="{Binding SetLanguageCommand}" CommandParameter="tr"
                                    Padding="6,2" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                    Background="{Binding IsTurkish, Converter={StaticResource LanguageActiveBgConverter}}"
                                    Foreground="{Binding IsTurkish, Converter={StaticResource LanguageActiveFgConverter}}"
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                                    Padding="6,2" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                    Background="{Binding IsEnglish, Converter={StaticResource LanguageActiveBgConverter}}"
                                    Foreground="{Binding IsEnglish, Converter={StaticResource LanguageActiveFgConverter}}"
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Settings Button -->
                    <Button Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="6" Cursor="Hand" ToolTip="{Binding Strings.SettingsToolTip}"
                            Command="{Binding ToggleSettingsCommand}">
                        <Path Fill="#94A3B8" Width="16" Height="16" Stretch="Uniform"
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN WORKSPACE (SIDEBAR + CONTENT) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar -->
                <ColumnDefinition Width="190" />
                <!-- Main Content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Bottom Local Physical Drives List -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Strings.LocalDrives}" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="14,10,14,4" FontFamily="Segoe UI" />
                        <ItemsControl ItemsSource="{Binding DriveCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DriveCardButtonStyle}"
                                            Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding DriveName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Crisp Vector Icon: HDD / USB -->
                                            <Path Grid.Column="0" Fill="#38BDF8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="M2,4H22V20H2V4M4,6V18H20V6H4M6,15A1,1 0 0,0 5,16A1,1 0 0,0 6,17A1,1 0 0,0 7,16A1,1 0 0,0 6,15M10,15A1,1 0 0,0 9,16A1,1 0 0,0 10,17A1,1 0 0,0 11,16A1,1 0 0,0 10,15Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Drive Name and Free Space -->
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding DriveName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedFreeText}" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <!-- Mini Usage Bar -->
                                                <Border Height="3" Background="#1E293B" CornerRadius="1.5" Margin="0,3,0,2">
                                                    <Border HorizontalAlignment="Left" Background="#38BDF8" CornerRadius="1.5"
                                                            Width="{Binding UsedPercent, Converter={StaticResource PercentToWidthConverter}}" />
                                                </Border>
                                                <!-- Used Space -->
                                                <TextBlock Text="{Binding FormattedUsed, StringFormat='{}{0} used'}" Foreground="#94A3B8" FontSize="9" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Top Navigation Items with Crisp Vector SVG Icons (No Emojis!) -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <!-- Overview Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding ShowDashboardCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="#38BDF8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"
                                      Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
                                <TextBlock Text="{Binding Strings.NavOverview}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Installed Apps Button (Feature #1) -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding ShowInstalledAppsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="#818CF8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"
                                      Data="M4,4H10V10H4V4M14,4H20V10H14V4M4,14H10V20H4V14M14,14H20V20H14V14Z" />
                                <TextBlock Text="{Binding Strings.NavInstalledApps}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- File Explorer Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding SelectedNode}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="#FBBF24" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"
                                      Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
                                <TextBlock Text="{Binding Strings.NavFileExplorer}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Top Files Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding ShowTopFilesCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="#34D399" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"
                                      Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" />
                                <TextBlock Text="{Binding Strings.NavTopFiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Large Files Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding ShowLargeFilesCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="#F472B6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"
                                      Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z" />
                                <TextBlock Text="{Binding Strings.NavLargeFiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Command="{Binding ToggleSettingsCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"
                                      Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                <TextBlock Text="{Binding Strings.NavSettings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN WORKSPACE CONTENT CONTAINER -->
            <Grid Grid.Column="1" Background="#0B132B">

                <!-- 1. DASHBOARD VIEW (UPPER SPLIT + LOWER SUMMARY CARDS) -->
                <Grid Visibility="{Binding IsDashboardViewActive, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <!-- Upper Split: Tree Grid + Treemap Blocks -->
                        <RowDefinition Height="1.1*" />
                        <!-- Lower Section: Tabs & 3 Summary Cards -->
                        <RowDefinition Height="230" />
                    </Grid.RowDefinitions>

                    <!-- UPPER SECTION (SPLIT: TREE GRID + TREEMAP) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Tree Grid -->
                            <ColumnDefinition Width="1.1*" />
                            <!-- Right: Treemap Blocks -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. TREE GRID CARD -->
                        <Border Grid.Column="0" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="8,8,4,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Tree Toolbar -->
                                <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="7,7,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="≡ Tree View" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Content="{Binding Strings.ExpandLevel, StringFormat='⊞ {0}'}" Command="{Binding ExpandNextLevelCommand}"
                                                ToolTip="Sonraki alt seviyedeki klasörleri sırayla açar"
                                                Background="#25334D" Foreground="#38BDF8" BorderThickness="1" BorderBrush="#38BDF8" Padding="7,3" Cursor="Hand" Margin="0,0,8,0" FontSize="11">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="{Binding Strings.CollapseLevel, StringFormat='⊟ {0}'}" Command="{Binding CollapseLevelCommand}"
                                                ToolTip="En son açılan seviyedeki klasörleri kapatır"
                                                Background="#1E293B" Foreground="#94A3B8" BorderThickness="1" BorderBrush="#334155" Padding="7,3" Cursor="Hand" Margin="0,0,10,0" FontSize="11">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="{Binding Strings.ExpandAll, StringFormat='⊞ {0}'}" Command="{Binding ExpandAllCommand}"
                                                ToolTip="Tüm seviyeleri genişletir (güvenli sınırla)"
                                                Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" FontSize="11" />
                                        <Button Content="{Binding Strings.CollapseAll, StringFormat='⊟ {0}'}" Command="{Binding CollapseAllCommand}"
                                                ToolTip="Tüm alt dalları kapatıp kök dizine döner"
                                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="11" />
                                    </DockPanel>
                                </Border>

                                <!-- Tree Table ListView -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding VisibleNodes}"
                                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          MouseDoubleClick="ListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <!-- Name Column with Hierarchy Indent & Expand Toggle -->
                                            <GridViewColumn Width="280">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Name" Click="GridViewColumnHeader_Click" Tag="Name" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}" Height="22" VerticalAlignment="Center">
                                                            <!-- OneWay bound expander toggle fixes instant closure bug! -->
                                                            <ToggleButton Style="{StaticResource NodeExpanderButtonStyle}"
                                                                          IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                                          Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"
                                                                          Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}"
                                                                          VerticalAlignment="Center" />
                                                            <Border Width="16" Height="16" Visibility="{Binding HasChildren, Converter={StaticResource InvertedBoolToVisibility}}" />

                                                            <!-- Folder / File Icon -->
                                                            <Grid Width="16" Height="16" Margin="2,0,6,0" VerticalAlignment="Center">
                                                                <Path Stretch="Uniform" Fill="#FBBF24"
                                                                      Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                                                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}" />
                                                                <Path Stretch="Uniform" Fill="#94A3B8"
                                                                      Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </Grid>

                                                            <!-- Name Text -->
                                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />

                                                            <!-- Feature #2: System Folder Amber Badge / Warning -->
                                                            <Border Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="3"
                                                                    Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSystemNode, Converter={StaticResource BoolToVisibility}}"
                                                                    ToolTip="İşletim Sistemi Klasörü - Windows için gereklidir, değiştirilmesi veya silinmesi önerilmez.">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Fill="#F59E0B" Width="9" Height="9" Stretch="Uniform" Margin="0,0,3,0"
                                                                          Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,7H13V13H11V7M11,15H13V17H11V15Z" />
                                                                    <TextBlock Text="Sistem" Foreground="#FBBF24" FontSize="9" FontWeight="Bold" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- Size Column -->
                                            <GridViewColumn Width="85">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Size" Click="GridViewColumnHeader_Click" Tag="Size" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <TextBlock Text="{Binding FormattedSize}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- % Column with Blue Gradient Bar -->
                                            <GridViewColumn Width="105">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="%" Click="GridViewColumnHeader_Click" Tag="Percent" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="60" Height="8" Background="#1E293B" CornerRadius="4" Margin="0,0,6,0">
                                                                <Border HorizontalAlignment="Left" CornerRadius="4" Background="#38BDF8"
                                                                        Width="{Binding PercentOfParent, Converter={StaticResource PercentToWidthConverter}}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding FormattedPercent}" FontSize="10" Foreground="#94A3B8" Width="32" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 2. VISUALIZATION CARD (TREEMAP / SUNBURST) -->
                        <Border Grid.Column="1" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="4,8,8,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Visualization Mode Switcher Toolbar -->
                                <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="7,7,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="Görselleştirme:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        
                                        <!-- Treemap Button -->
                                        <Button Command="{Binding SelectChartModeCommand}" CommandParameter="Treemap"
                                                Cursor="Hand" Padding="8,3" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Setter Property="BorderBrush" Value="#334155" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTreemapChartSelected}" Value="True">
                                                            <Setter Property="Background" Value="#25334D" />
                                                            <Setter Property="Foreground" Value="#38BDF8" />
                                                            <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="📊 Treemap (Harita)" />
                                        </Button>

                                        <!-- Sunburst Button -->
                                        <Button Command="{Binding SelectChartModeCommand}" CommandParameter="Sunburst"
                                                Cursor="Hand" Padding="8,3" FontSize="11" FontWeight="SemiBold">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1E293B" />
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Setter Property="BorderBrush" Value="#334155" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSunburstChartSelected}" Value="True">
                                                            <Setter Property="Background" Value="#25334D" />
                                                            <Setter Property="Foreground" Value="#F59E0B" />
                                                            <Setter Property="BorderBrush" Value="#F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="☀️ Sunburst (Halka)" />
                                        </Button>
                                    </DockPanel>
                                </Border>

                                <!-- Visualization Views Content -->
                                <Grid Grid.Row="1">
                                    <views:TreemapControl DataContext="{Binding}">
                                        <views:TreemapControl.Style>
                                            <Style TargetType="views:TreemapControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTreemapChartSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:TreemapControl.Style>
                                    </views:TreemapControl>

                                    <views:SunburstControl DataContext="{Binding}">
                                        <views:SunburstControl.Style>
                                            <Style TargetType="views:SunburstControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSunburstChartSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:SunburstControl.Style>
                                    </views:SunburstControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LOWER SECTION: TABS (SUMMARY, DETAILS, FILES) -->
                    <Grid Grid.Row="1" Margin="8,4,8,8">
                        <Grid.RowDefinitions>
                            <!-- Tabs Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Tab Content -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tabs Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,6">
                            <Button Command="{Binding SelectBottomTabCommand}" CommandParameter="Summary"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                <Border BorderThickness="0,0,0,2" Padding="12,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Summary (Özet)" FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSummaryTabSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>

                            <Button Command="{Binding SelectBottomTabCommand}" CommandParameter="Details"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                <Border BorderThickness="0,0,0,2" Padding="12,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetailsTabSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Details (Ayrıntılar)" FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDetailsTabSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>

                            <Button Command="{Binding SelectBottomTabCommand}" CommandParameter="Files"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                <Border BorderThickness="0,0,0,2" Padding="12,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilesTabSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Files (Dosyalar)" FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilesTabSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>
                        </StackPanel>

                        <!-- Tab Content -->
                        <!-- 1. SUMMARY: 4 CARDS (DONUT CHART + FOLDER INFO + TOP 5 FOLDERS + FILE TYPES) -->
                        <Grid Grid.Row="1" Visibility="{Binding IsSummaryTabSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <!-- Card 1: Donut Chart -->
                                <ColumnDefinition Width="1.1*" />
                                <!-- Card 2: Folder Information -->
                                <ColumnDefinition Width="*" />
                                <!-- Card 3: Top 5 Largest Folders -->
                                <ColumnDefinition Width="1.1*" />
                                <!-- Card 4: File Types (Uzantılar) -->
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <!-- CARD 1: DONUT CHART -->
                            <Border Grid.Column="0" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="0,0,4,0" Padding="8">
                                <views:DonutChartControl DataContext="{Binding}" />
                            </Border>

                            <!-- CARD 2: FOLDER INFORMATION -->
                            <Border Grid.Column="1" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="4,0,4,0" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Folder Information" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,8" />

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="#64748B" FontSize="11" Margin="0,2" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedNode.Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Path" Foreground="#64748B" FontSize="11" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNode.FullPath}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Foreground="#64748B" FontSize="11" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNode.FormattedSize}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,2" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Files" Foreground="#64748B" FontSize="11" Margin="0,2" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNode.FormattedFiles}" Foreground="#CBD5E1" FontSize="11" Margin="0,2" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Folders" Foreground="#64748B" FontSize="11" Margin="0,2" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedNode.FormattedFolders}" Foreground="#CBD5E1" FontSize="11" Margin="0,2" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Modified" Foreground="#64748B" FontSize="11" Margin="0,2" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedNode.FormattedLastModified}" Foreground="#64748B" FontSize="10" Margin="0,2" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- CARD 3: TOP 5 LARGEST FOLDERS -->
                            <Border Grid.Column="2" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="4,0,4,0" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="Top 5 Largest Folders" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock DockPanel.Dock="Right" Text="Size" Foreground="#64748B" FontSize="11" />
                                    </DockPanel>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Top5SubFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="📁" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                    <Border Grid.Column="2" Width="60" Height="6" CornerRadius="3" Background="#1E293B" Margin="8,0" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="#2563EB"
                                                                Width="{Binding PercentOfParent, Converter={StaticResource Top5BarWidthConverter}}" />
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Width="55" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- CARD 4: FILE TYPES / EXTENSIONS (Feature #2) -->
                            <Border Grid.Column="3" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="4,0,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock Text="File Types (Uzantılar)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock DockPanel.Dock="Right" Text="Boyut" Foreground="#64748B" FontSize="11" />
                                    </DockPanel>

                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TopExtensions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:FileExtensionSummary}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Extension}" Foreground="{Binding ColorHex}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedCount}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                    <Border Grid.Column="2" Height="5" CornerRadius="2.5" Background="#1E293B" Margin="4,0" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Left" CornerRadius="2.5" Background="{Binding ColorHex}"
                                                                Width="{Binding Percentage, Converter={StaticResource Top5BarWidthConverter}}" />
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Width="55" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2. DETAILS TAB CONTENT (Feature #4) -->
                        <Border Grid.Row="1" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                Visibility="{Binding IsDetailsTabSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Path and Size Info -->
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Temel Bilgiler" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" Margin="0,0,0,8" />
                                    <TextBlock Text="Tam Yol:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FullPath}" Foreground="#FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <TextBlock Text="Gerçek Boyut:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FormattedSize}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />

                                    <TextBlock Text="Diskte Ayrılan Alan (Cluster):" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FormattedAllocated}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,6" />
                                </StackPanel>

                                <!-- Column 2: File Counts and Dates -->
                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                    <TextBlock Text="Dosya &amp; Zaman İstatistikleri" FontWeight="Bold" Foreground="#818CF8" FontSize="12" Margin="0,0,0,8" />
                                    <TextBlock Text="Dosya Sayısı:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FormattedFiles}" Foreground="#FFFFFF" FontSize="11" Margin="0,0,0,6" />

                                    <TextBlock Text="Alt Klasör Sayısı:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FormattedFolders}" Foreground="#FFFFFF" FontSize="11" Margin="0,0,0,6" />

                                    <TextBlock Text="Son Değiştirilme:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FormattedLastModified}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,6" />
                                </StackPanel>

                                <!-- Column 3: Hierarchy and Security -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Durum ve Hiyerarşi" FontWeight="Bold" Foreground="#34D399" FontSize="12" Margin="0,0,0,8" />
                                    <TextBlock Text="Hiyerarşi Derinliği (Level):" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.Level}" Foreground="#FFFFFF" FontSize="11" Margin="0,0,0,6" />

                                    <TextBlock Text="Üst Klasöre Oranı:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.FormattedPercent}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />

                                    <TextBlock Text="Sistem Klasörü mü?:" Foreground="#64748B" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedNode.IsSystemNode}" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. FILES TAB CONTENT (Feature #4) -->
                        <Border Grid.Row="1" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding IsFilesTabSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6" CornerRadius="7,7,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="Klasör İçindeki Dosyalar" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedFolderFiles.Count, StringFormat=' ({0} Dosya)'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </DockPanel>
                                </Border>

                                <ListView Grid.Row="1" ItemsSource="{Binding SelectedFolderFiles}"
                                          Background="Transparent" BorderThickness="0"
                                          MouseDoubleClick="ListView_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Dosya Adı" Width="320">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Boyut" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <TextBlock Text="{Binding FormattedSize}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Ayrılan Boyut" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <TextBlock Text="{Binding FormattedAllocated}" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="Son Değiştirilme" Width="140">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <TextBlock Text="{Binding FormattedLastModified}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="İşlem" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                                        <Button Content="Klasörde Aç"
                                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding FullPath}"
                                                                Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"
                                                                Padding="6,2" FontSize="10" Cursor="Hand" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 2. INSTALLED APPLICATIONS VIEW (Feature #1) -->
                <Grid Visibility="{Binding IsAppsViewActive, Converter={StaticResource BoolToVisibility}}" Margin="10">
                    <Border Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Apps Header -->
                            <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="7,7,0,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Fill="#818CF8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                              Data="M4,4H10V10H4V4M14,4H20V10H14V4M4,14H10V20H4V14M14,14H20V20H14V14Z" />
                                        <TextBlock Text="{Binding Strings.InstalledAppsTitle}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding InstalledApps.Count, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right" Content="{Binding Strings.CloseToDashboard}"
                                            Command="{Binding ShowDashboardCommand}"
                                            Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"
                                            Padding="10,4" Cursor="Hand" FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>

                            <!-- Apps ListView (with Column Click Sorting!) -->
                            <ListView Grid.Row="1" ItemsSource="{Binding InstalledApps}"
                                      GridViewColumnHeader.Click="InstalledAppsColumnHeader_Click"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="360">
                                            <GridViewColumnHeader Content="{Binding InstalledAppsColNameHeader}" Tag="Name" Cursor="Hand" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:InstalledAppModel}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Fill="#818CF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                                              Data="M4,4H10V10H4V4M14,4H20V10H14V4M4,14H10V20H4V14M14,14H20V20H14V14Z" />
                                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Width="200">
                                            <GridViewColumnHeader Content="{Binding InstalledAppsColPublisherHeader}" Tag="Publisher" Cursor="Hand" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:InstalledAppModel}">
                                                    <TextBlock Text="{Binding Publisher}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Width="100">
                                            <GridViewColumnHeader Content="{Binding InstalledAppsColVersionHeader}" Tag="Version" Cursor="Hand" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:InstalledAppModel}">
                                                    <TextBlock Text="{Binding Version}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Width="150">
                                            <GridViewColumnHeader Content="{Binding InstalledAppsColLastRunHeader}" Tag="LastRunTime" Cursor="Hand" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:InstalledAppModel}">
                                                    <TextBlock Text="{Binding RelativeLastRun}" ToolTip="{Binding FormattedLastRun}" Foreground="#34D399" FontSize="11" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Width="140">
                                            <GridViewColumnHeader Content="{Binding InstalledAppsColSizeHeader}" Tag="SizeBytes" Cursor="Hand" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:InstalledAppModel}">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Width="130">
                                            <GridViewColumnHeader Content="{Binding InstalledAppsColPercentHeader}" Tag="PercentOfTotal" Cursor="Hand" />
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:InstalledAppModel}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="70" Height="8" Background="#1E293B" CornerRadius="4" Margin="0,0,6,0">
                                                            <Border HorizontalAlignment="Left" CornerRadius="4" Background="#818CF8"
                                                                    Width="{Binding PercentOfTotal, Converter={StaticResource AppPercentBarConverter}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FormattedPercent}" FontSize="10" Foreground="#94A3B8" Width="32" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. TOP FILES VIEW (Feature #3) -->
                <Grid Visibility="{Binding IsTopFilesViewActive, Converter={StaticResource BoolToVisibility}}" Margin="10">
                    <Border Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="7,7,0,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Fill="#34D399" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                              Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z" />
                                        <TextBlock Text="{Binding Strings.TopFilesTitle}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TopFilesList.Count, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right" Content="{Binding Strings.CloseToDashboard}"
                                            Command="{Binding ShowDashboardCommand}"
                                            Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"
                                            Padding="10,4" Cursor="Hand" FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>

                            <!-- Top Files ListView -->
                            <ListView Grid.Row="1" ItemsSource="{Binding TopFilesList}"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="45">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" Foreground="#64748B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Dosya Adı" Width="280">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"
                                                              Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Klasör Konumu" Width="320">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding DirectoryPath}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryPath}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Uzantı" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <Border Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Extension}" Foreground="#A78BFA" FontWeight="SemiBold" FontSize="10" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Boyut" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Son Değiştirilme" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding FormattedLastModified}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="İşlem" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <Button Content="Klasörde Aç"
                                                            Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"
                                                            Padding="6,2" FontSize="10" Cursor="Hand" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. LARGE FILES VIEW (Feature #3) -->
                <Grid Visibility="{Binding IsLargeFilesViewActive, Converter={StaticResource BoolToVisibility}}" Margin="10">
                    <Border Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="7,7,0,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Fill="#F43F5E" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                              Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z" />
                                        <TextBlock Text="{Binding Strings.LargeFilesTitle}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LargeFilesList.Count, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right" Content="{Binding Strings.CloseToDashboard}"
                                            Command="{Binding ShowDashboardCommand}"
                                            Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"
                                            Padding="10,4" Cursor="Hand" FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>

                            <!-- Size Filter Bar -->
                            <Border Grid.Row="1" Background="#111B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Boyut Filtresi:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <Button Content="&gt; 50 MB"
                                            Command="{Binding FilterLargeFilesCommand}" CommandParameter="52428800"
                                            Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,3" Margin="0,0,6,0" FontSize="11" Cursor="Hand" />
                                    <Button Content="&gt; 100 MB"
                                            Command="{Binding FilterLargeFilesCommand}" CommandParameter="104857600"
                                            Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,3" Margin="0,0,6,0" FontSize="11" Cursor="Hand" />
                                    <Button Content="&gt; 500 MB"
                                            Command="{Binding FilterLargeFilesCommand}" CommandParameter="524288000"
                                            Background="#1E293B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,3" Margin="0,0,6,0" FontSize="11" Cursor="Hand" />
                                    <Button Content="&gt; 1 GB"
                                            Command="{Binding FilterLargeFilesCommand}" CommandParameter="1073741824"
                                            Background="#1E293B" Foreground="#F59E0B" FontWeight="Bold" BorderThickness="0" Padding="8,3" Margin="0,0,6,0" FontSize="11" Cursor="Hand" />
                                    <Button Content="&gt; 5 GB"
                                            Command="{Binding FilterLargeFilesCommand}" CommandParameter="5368709120"
                                            Background="#1E293B" Foreground="#F43F5E" FontWeight="Bold" BorderThickness="0" Padding="8,3" Margin="0,0,6,0" FontSize="11" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Large Files ListView -->
                            <ListView Grid.Row="2" ItemsSource="{Binding LargeFilesList}"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="45">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" Foreground="#64748B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Dosya Adı" Width="280">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Fill="#F43F5E" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"
                                                              Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" ToolTip="{Binding FullPath}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Klasör Konumu" Width="320">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding DirectoryPath}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryPath}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Boyut" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#F43F5E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Son Değiştirilme" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <TextBlock Text="{Binding FormattedLastModified}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="İşlem" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type models:TopFileItem}">
                                                    <Button Content="Klasörde Aç"
                                                            Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"
                                                            Padding="6,2" FontSize="10" Cursor="Hand" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. SETTINGS MODAL OVERLAY (Feature #3) -->
                <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}"
                      Background="#AA000000">
                    <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#151F32" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"
                                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                    <TextBlock Text="{Binding Strings.SettingsTitle}" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ToggleSettingsCommand}"
                                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Cursor="Hand" />
                            </DockPanel>

                            <!-- Language Option -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings.LanguageLabel}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock Text="{Binding Strings.LanguageDesc}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Türkçe" Command="{Binding SetLanguageCommand}" CommandParameter="tr"
                                                Margin="0,0,6,0" Padding="12,5" Cursor="Hand" FontWeight="SemiBold"
                                                Background="{Binding IsTurkish, Converter={StaticResource LanguageActiveBgConverter}}"
                                                Foreground="{Binding IsTurkish, Converter={StaticResource LanguageActiveFgConverter}}"
                                                BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="English" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                                                Padding="12,5" Cursor="Hand" FontWeight="SemiBold"
                                                Background="{Binding IsEnglish, Converter={StaticResource LanguageActiveBgConverter}}"
                                                Foreground="{Binding IsEnglish, Converter={StaticResource LanguageActiveFgConverter}}"
                                                BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Feature #3: Toggle System Folders in Treemap -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding HideSystemInTreemap, Mode=TwoWay}"
                                          VerticalContentAlignment="Center" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Strings.HideSystemFolders}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock Text="{Binding Strings.HideSystemFoldersDesc}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Feature: Balanced Scale in Treemap -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding UseBalancedTreemapScale, Mode=TwoWay}"
                                          VerticalContentAlignment="Center" Cursor="Hand">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Strings.UseBalancedScale}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock Text="{Binding Strings.UseBalancedScaleDesc}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Restart as Admin Option -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="{Binding Strings.RunAsAdminBtn}"
                                            Command="{Binding RestartAsAdminCommand}"
                                            Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                                            Padding="10,5" Cursor="Hand" FontWeight="SemiBold" />
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Strings.RunAsAdmin}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" />
                                        <TextBlock Text="{Binding Strings.RunAsAdminDesc}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Close Button -->
                            <Button Content="{Binding Strings.CloseBtn}" Command="{Binding ToggleSettingsCommand}"
                                    Background="#334155" Foreground="#FFFFFF" BorderThickness="0"
                                    Padding="0,8" Cursor="Hand" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Scanning Live Indicator & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="80" Height="8"
                                 Margin="0,0,10,0"
                                 Foreground="#38BDF8"
                                 Background="#1E293B"
                                 BorderThickness="0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Summary Totals -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Toplam: " Foreground="#64748B" FontSize="11" />
                    <TextBlock Text="{Binding FormattedTotalSize}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" Margin="0,0,12,0" />

                    <TextBlock Text="Dosyalar: " Foreground="#64748B" FontSize="11" />
                    <TextBlock Text="{Binding FormattedTotalFiles}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" Margin="0,0,12,0" />

                    <TextBlock Text="Klasörler: " Foreground="#64748B" FontSize="11" />
                    <TextBlock Text="{Binding FormattedTotalFolders}" FontWeight="SemiBold" Foreground="#FBBF24" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
