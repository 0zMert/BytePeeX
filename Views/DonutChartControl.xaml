<UserControl x:Class="BytePeeX.Views.DonutChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="360"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Donut Canvas -->
        <Grid Grid.Column="0" x:Name="DonutContainer" SizeChanged="DonutContainer_SizeChanged" Margin="2">
            <Canvas x:Name="DonutCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Center Circle Display -->
            <Border Width="52" Height="52"
                    CornerRadius="26"
                    Background="#151F32"
                    BorderBrush="#334155"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtTotalSize"
                               Text="{Binding FormattedTotalSize}"
                               FontWeight="Bold"
                               FontSize="10"
                               Foreground="#FFFFFF"
                               TextAlignment="Center" />
                    <TextBlock Text="Total"
                               FontSize="8"
                               Foreground="#94A3B8"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Legend List -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,0,0">
            <ItemsControl ItemsSource="{Binding TopSegments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding ColorHex}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding FormattedSize}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" />
                                <TextBlock Text="{Binding FormattedPercentage, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
