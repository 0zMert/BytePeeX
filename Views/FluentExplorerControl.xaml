<UserControl x:Class="Folderize.Views.FluentExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Folderize.Models"
             xmlns:converters="clr-namespace:Folderize.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#181818">

    <UserControl.Resources>
        <converters:PercentToWidthConverter x:Key="PercentToWidthConverter" MaxWidth="110.0" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Fluent Capacity Bar -->
            <RowDefinition Height="Auto" />
            <!-- Breadcrumb Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- Flat Data Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. FLUENT STORAGE CAPACITY BAR -->
        <Border Grid.Row="0" Background="#202226" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock Text="Kapasite Dağılımı (Mevcut Klasör)" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="11" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentDrillDownNode.FormattedSize}" FontWeight="Bold" Foreground="#00E5FF" FontSize="11" />
                </DockPanel>

                <!-- Multi-segment visual bar -->
                <Border Height="12" CornerRadius="6" Background="#111111" ClipToBounds="True" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding TopSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="12"
                                        Width="{Binding Percentage, Converter={StaticResource PercentToWidthConverter}}"
                                        Background="{Binding ColorHex}"
                                        ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Legend pills -->
                <ItemsControl ItemsSource="{Binding TopSegments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ColorHex}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Name}" Foreground="#AAAAAA" FontSize="11" />
                                <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" Foreground="#777777" FontSize="10" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 2. BREADCRUMB ADDRESS BAR -->
        <Border Grid.Row="1" Background="#252528" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel LastChildFill="True">
                <!-- Back / Up Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
                    <Button Content="◀ Geri"
                            Command="{Binding NavigateBackCommand}"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            BorderBrush="#444444"
                            Padding="8,3"
                            Margin="0,0,4,0"
                            Cursor="Hand" />

                    <Button Content="▲ Üst Dizin"
                            Command="{Binding NavigateUpCommand}"
                            Background="#2D2D30"
                            Foreground="#FFFFFF"
                            BorderBrush="#444444"
                            Padding="8,3"
                            Cursor="Hand" />
                </StackPanel>

                <!-- Breadcrumb pills -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding BreadcrumbNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.DrillToNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#1E1E1E"
                                            Foreground="#4FC3F7"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            FontWeight="SemiBold"
                                            Margin="2,0" />
                                    <TextBlock Text="❯" Foreground="#555555" Margin="2,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 3. FLAT LIST VIEW -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding CurrentFolderItems}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  Background="#181818"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <!-- Name Column -->
                    <GridViewColumn Width="380">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Name" Click="ColumnHeader_Click" Tag="Name" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <StackPanel Orientation="Horizontal" Height="24" VerticalAlignment="Center">
                                    <!-- Icon -->
                                    <Grid Width="18" Height="18" Margin="4,0,8,0" VerticalAlignment="Center">
                                        <!-- Folder Icon -->
                                        <Path Stretch="Uniform" Fill="#F3C647"
                                              Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                              Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- File Icon -->
                                        <Path Stretch="Uniform" Fill="#85929E"
                                              Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>

                                    <!-- Name Text -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#F1F1F1" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size Column -->
                    <GridViewColumn Width="110">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Size" Click="ColumnHeader_Click" Tag="Size" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <TextBlock Text="{Binding FormattedSize}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Allocated Column -->
                    <GridViewColumn Width="110">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Allocated" Click="ColumnHeader_Click" Tag="Allocated" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <TextBlock Text="{Binding FormattedAllocated}" HorizontalAlignment="Right" Foreground="#B0B0B0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Files Column -->
                    <GridViewColumn Width="90">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Files" Click="ColumnHeader_Click" Tag="Files" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <TextBlock Text="{Binding FormattedFiles}" HorizontalAlignment="Right" Foreground="#CCCCCC" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Folders Column -->
                    <GridViewColumn Width="90">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Folders" Click="ColumnHeader_Click" Tag="Folders" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <TextBlock Text="{Binding FormattedFolders}" HorizontalAlignment="Right" Foreground="#CCCCCC" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- % of Parent Column -->
                    <GridViewColumn Width="130">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="% of Parent" Click="ColumnHeader_Click" Tag="Percent" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <Grid Width="110" Height="16" HorizontalAlignment="Left">
                                    <Border Background="#2B2B2B" CornerRadius="2" />
                                    <Border Background="{StaticResource PercentBarBlue}"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            Width="{Binding PercentOfParent, Converter={StaticResource PercentToWidthConverter}}" />
                                    <TextBlock Text="{Binding FormattedPercent}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Last Modified Column -->
                    <GridViewColumn Width="140">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Last Modified" Click="ColumnHeader_Click" Tag="LastModified" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:FileSystemNode}">
                                <TextBlock Text="{Binding FormattedLastModified}" HorizontalAlignment="Center" Foreground="#888888" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
