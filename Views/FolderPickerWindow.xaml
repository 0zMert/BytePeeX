<Window x:Class="BytePeeX.Views.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BytePeeX.Models"
        Title="Sürücü veya Klasör Seç"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Drive Card Button Style -->
        <Style x:Key="DriveCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#151F32" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Access Button Style -->
        <Style x:Key="QuickAccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25334D" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#151F32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window DropShadow Container -->
    <Border Margin="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.75" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="Auto" />
                <!-- Content -->
                <RowDefinition Height="*" />
                <!-- Footer / Custom Folder Button -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. TITLEBAR -->
            <Border Grid.Row="0" Background="#1A263C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <!-- Close (X) Button -->
                    <Button DockPanel.Dock="Right" Content="✕" Click="CloseButton_Click"
                            Width="26" Height="26" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Cursor="Hand" FontSize="13" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#EF4444" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Title & Subtitle -->
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Strings.FolderPickerTitle}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                        </StackPanel>
                        <TextBlock Text="{Binding Strings.FolderPickerSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="24,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. CONTENT AREA -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                <StackPanel>
                    <!-- SECTION A: Yerel Sürücüler -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Strings.LocalDrivesTitle}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock Text="{Binding Strings.LocalDrivesSubtitle}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ItemsControl x:Name="DrivesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DriveCardModel}">
                                <Button Style="{StaticResource DriveCardButtonStyle}" Margin="4" Click="DriveCard_Click" Tag="{Binding DriveName}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header: Drive Name & Removable/Fixed -->
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💽" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DriveDisplayName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedPercent}" FontWeight="Bold" FontSize="11" Foreground="{Binding BarBrush}" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Sizes: Used / Total -->
                                        <TextBlock Grid.Row="1" Text="{Binding UsageSummary}" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,6" />

                                        <!-- Capacity Bar -->
                                        <Border Grid.Row="2" Height="6" Background="#0F172A" CornerRadius="3" ClipToBounds="True">
                                            <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Minimum="0" Height="6" BorderThickness="0" Background="Transparent" Foreground="{Binding BarBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,14,0,12" Background="#1E293B" />

                    <!-- SECTION B: Hızlı Erişim Klasörleri -->
                    <TextBlock Text="{Binding Strings.QuickAccessTitle}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8" />

                    <UniformGrid Columns="2">
                        <!-- Desktop -->
                        <Button Style="{StaticResource QuickAccessButtonStyle}" Margin="4" Click="QuickFolder_Click" Tag="Desktop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥️" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Strings.FolderDesktop}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <!-- Downloads -->
                        <Button Style="{StaticResource QuickAccessButtonStyle}" Margin="4" Click="QuickFolder_Click" Tag="Downloads">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📥" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Strings.FolderDownloads}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <!-- Documents -->
                        <Button Style="{StaticResource QuickAccessButtonStyle}" Margin="4" Click="QuickFolder_Click" Tag="Documents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Strings.FolderDocuments}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <!-- User Profile Home -->
                        <Button Style="{StaticResource QuickAccessButtonStyle}" Margin="4" Click="QuickFolder_Click" Tag="UserProfile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Strings.FolderUserProfile}" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. FOOTER / BROWSE BUTTON -->
            <Border Grid.Row="2" Background="#151F32" BorderBrush="#1E293B" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="16,12">
                <DockPanel LastChildFill="False">
                    <!-- Cancel Button -->
                    <Button Content="{Binding Strings.Cancel}" Click="CloseButton_Click" DockPanel.Dock="Left"
                            Background="Transparent" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1"
                            Padding="14,6" Cursor="Hand" FontSize="11" FontWeight="SemiBold" />

                    <!-- Custom Folder / Browse Button -->
                    <Button Click="BrowseSystemFolder_Click" DockPanel.Dock="Right"
                            Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="16,6" Cursor="Hand" FontSize="11" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Strings.BrowseOtherFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
