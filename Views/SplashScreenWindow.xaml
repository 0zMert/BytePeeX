<Window x:Class="Folderize.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Folderize"
        Icon="/app.ico"
        Width="500" Height="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Border Margin="15" CornerRadius="16" Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <!-- Top Gradient Accent Line -->
            <Border Height="3" VerticalAlignment="Top" CornerRadius="16,16,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2563EB" Offset="0.0" />
                        <GradientStop Color="#38BDF8" Offset="0.5" />
                        <GradientStop Color="#818CF8" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Version Badge (Top Right) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0"
                    Background="#151F32" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtVersion" Text="v0.1" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Center: Icon & Title -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="16" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Image Source="/Resources/icon_256.png" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Folderize" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center" />
                    <TextBlock Text="Disk Alanı ve Klasör Analiz Aracı" FontSize="12" Foreground="#94A3B8" TextAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Bottom: Animated Progress Bar & Status -->
                <StackPanel Grid.Row="1" Margin="6,10,6,4">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtStatus" Text="Başlatılıyor..." Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Left" />
                        <TextBlock x:Name="TxtPercent" Text="0%" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Progress Bar Track -->
                    <Border x:Name="ProgressBarTrack" Height="6" CornerRadius="3" Background="#151F32" BorderBrush="#1E293B" BorderThickness="1">
                        <!-- Progress Fill with Gradient -->
                        <Border x:Name="ProgressBarFill" Height="4" CornerRadius="2" HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0.0" />
                                    <GradientStop Color="#38BDF8" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
